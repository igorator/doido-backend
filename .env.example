# ─────────────────────────────────────────────
#  DOIDO Backend — Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── App ────────────────────────────────────────
NODE_ENV=development          # development | production
SERVER_PORT=8080              # HTTP server port (fallback: PORT)

# ── PostgreSQL ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=doido

# ── Telegram ───────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Public-facing base URL used to register the Grammy webhook
# Example: https://api.doido-market.com
BOT_WEBHOOK_URL=https://api.doido-market.com

# ── TON Blockchain ─────────────────────────────
# TonCenter endpoint & API key
TONCENTER_API_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=your_toncenter_api_key

# Wallet that receives user deposits (public address)
TON_DEPOSIT_WALLET_ADDRESS=your_deposit_wallet_address

# Hex-encoded private keys for deposit & withdraw wallets
TON_DEPOSIT_WALLET_SECRET_KEY=your_deposit_secret_key_hex
TON_WITHDRAW_WALLET_SECRET_KEY=your_withdraw_secret_key_hex

# Subwallet index for WalletV5R1 (default: 0)
TON_SUBWALLET_NUMBER=0

# ── TON Watcher Tuning ─────────────────────────
# Polling interval for deposit confirmations (ms)
TON_DEPOSIT_WATCHER_INTERVAL_MS=15000

# Polling interval for batching withdrawals (ms)
TON_WITHDRAW_INTERVAL_MS=15000

# Max withdrawals per batch
TON_WITHDRAW_MAX_BATCH_SIZE=20

# Amount auto-refilled to the withdraw wallet from deposit wallet when low (TON)
TON_WITHDRAW_REFILL_AMOUNT=50

# ── Marketplace Fees ──────────────────────────
# All values are multipliers unless stated otherwise.
# Defaults are defined in src/shared/constants.ts.

DEFAULT_FEE=0.01                        # 1%  — base marketplace fee
SELL_FEE=0.01                           # 1%  — applied to sell price
GIFT_LISTING_FEE=0.1                    # 10% — charged on listing
GIFT_TRANSFER_FEE=0.1                   # flat TON — gift transfer cost
GIFT_ORDER_PLACE_FEE=0.1               # flat TON — order placement fee
REFERRAL_FEE=0.2                        # 20% — referral cut of commission
INFLUENCER_REFERRAL_PERCENT_FEE=0.01   # 1%  — influencer cut of commission

# ── Price & Balance Limits ─────────────────────
MIN_SELL_PRICE=0.5
MAX_SELL_PRICE=50000
MIN_DEPOSIT_AMOUNT=0.1
MIN_WITHDRAW_AMOUNT=0.1
MAX_WITHDRAW_AMOUNT=50
MAX_FREE_LISTINGS=5
