{
  "name": "doido-backend",
  "version": "1.0.0",
  "description": "Backend for DOIDO using Grammy, TypeORM, TypeScript and Func",
  "main": "src/app.js",
  "type": "module",
  "author": {
    "name": "Ihor Kliushnyk"
  },
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "@ton/core": "^0.60.1",
    "@ton/crypto": "^3.3.0",
    "@ton/test-utils": "^0.6.0",
    "@ton/ton": "^15.2.1",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-slow-down": "^2.1.0",
    "fs-extra": "^11.3.5",
    "grammy": "^1.43.0",
    "helmet": "^8.2.0",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "tsx": "^4.22.3",
    "typeorm": "^0.3.22",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "typescript": "^5.8.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "@typescript-eslint/parser": "^7.3.0",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "prettier": "^3.0.0"
  }
}
