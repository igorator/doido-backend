{
  "compilerOptions": {
    "outDir": "dist",

    "emitDecoratorMetadata": true,

    "experimentalDecorators": true,

    "moduleDetection": "force",

    "module": "Preserve",

    "resolveJsonModule": true,

    "allowJs": true,

    "esModuleInterop": true,

    "isolatedModules": true
  },
  "exclude": ["node_modules", "**/*.js"]
}
